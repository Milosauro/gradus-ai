{
  "gradus": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "gradusctl guard",
            "type": "command"
          }
        ],
        "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content"
      }
    ],
    "SessionStart": [
      {
        "command": "gradusctl status --brief --antigravity-hook",
        "type": "command"
      }
    ]
  }
}
