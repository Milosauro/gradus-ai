{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "gradusctl guard",
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "gradusctl status --brief --hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
