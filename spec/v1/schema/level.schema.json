{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradus.ai/spec/v1/level.schema.json",
  "title": "Gradus Level Definition (level.yaml)",
  "type": "object",
  "required": ["schema", "id"],
  "additionalProperties": true,
  "properties": {
    "schema": { "type": "string", "const": "gradus/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string" },
    "min_version": { "type": "string" },
    "signature": { "type": "string", "enum": ["optional", "required"] },
    "owners": { "type": "array", "items": { "type": "string" } },
    "approvers": { "type": "array", "items": { "type": "string" } },
    "charter": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string" },
        "includes": { "type": "array", "items": { "type": "string" } },
        "excludes": { "type": "array", "items": { "type": "string" } },
        "examples_in": { "type": "array", "items": { "type": "string" } },
        "examples_out": { "type": "array", "items": { "type": "string" } },
        "allowed_severities": {
          "type": "array",
          "items": { "type": "string", "enum": ["MUST", "SHOULD", "MAY"] }
        },
        "review_cadence": { "type": "string" }
      }
    },
    "context_budget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_rules": { "type": "integer", "minimum": 0 },
        "max_chars": { "type": "integer", "minimum": 0 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "require_levels": { "type": "array", "items": { "type": "string" } },
        "max_extra_levels": { "type": "integer", "minimum": 0 },
        "allowed_overlays": { "type": "array", "items": { "type": "string" } }
      }
    },
    "activation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["overlay", "when"],
        "additionalProperties": true,
        "properties": {
          "overlay": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "when": { "type": "object", "minProperties": 1, "additionalProperties": true },
          "required": { "type": "boolean" }
        }
      }
    },
    "exceptions": {
      "type": "object",
      "properties": {
        "max_duration": { "type": "string" },
        "approvers": { "type": "array", "items": { "type": "string" } },
        "break_glass": { "type": "boolean" }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "allowed_providers": { "type": "array", "items": { "type": "string" } },
          "scope": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["obligation", "provider"],
        "additionalProperties": true,
        "properties": {
          "obligation": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "requires": { "type": "object", "additionalProperties": { "type": "string" } },
          "scope": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": { "type": "array" },
        "recommended": { "type": "array" },
        "forbidden": { "type": "array" }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tiers": { "type": "object" },
        "operations": { "type": "object" }
      }
    }
  }
}
